_name":"SliderStyleModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":"","handle_color":null}},"4749ef1863754f2f8d5c1cabc10aadd1":{"model_module":"@jupyter-widgets/controls","model_name":"SliderStyleModel","model_module_version":"1.5.0","state":{"_model_module":"@jupyter-widgets/controls","_model_module_version":"1.5.0","_model_name":"SliderStyleModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":"","handle_color":null}},"be6137881e88435d900b42080e3b17a9":{"model_module":"@jupyter-widgets/controls","model_name":"SliderStyleModel","model_module_version":"1.5.0","state":{"_model_module":"@jupyter-widgets/controls","_model_module_version":"1.5.0","_model_name":"SliderStyleModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":"","handle_color":null}},"26739de6518841cfbfd81c5121529da8":{"model_module":"@jupyter-widgets/base","model_name":"LayoutModel","model_module_version":"1.2.0","state":{"_model_module":"@jupyter-widgets/base","_model_module_version":"1.2.0","_model_name":"LayoutModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"LayoutView","align_content":null,"align_items":null,"align_self":null,"border":null,"bottom":null,"display":null,"flex":null,"flex_flow":null,"grid_area":null,"grid_auto_columns":null,"grid_auto_flow":null,"grid_auto_rows":null,"grid_column":null,"grid_gap":null,"grid_row":null,"grid_template_areas":null,"grid_template_columns":null,"grid_template_rows":null,"height":null,"justify_content":null,"justify_items":null,"left":null,"margin":null,"max_height":null,"max_width":null,"min_height":null,"min_width":null,"object_fit":null,"object_position":null,"order":null,"overflow":null,"overflow_x":null,"overflow_y":null,"padding":null,"right":null,"top":null,"visibility":null,"width":null}}}}}},"cells":[{"cell_type":"markdown","source":["# 1D Kalman Filter Lecture Notebook\n","\n","Il Filtro di Kalman stima lo stato di un sistema alternando due fasi principali:\n","1. **Predict (Time Update / Moto):** Proietta lo stato nel futuro usando il modello cinematico. L'incertezza (varianza) aumenta a causa del rumore di processo.\n","2. **Update (Measurement Correction / Sensore):** Unisce la stima *Prior* con la nuova misurazione rumorosa del sensore tramite la Regola di Bayes (prodotto di due Gaussiane).\n","\n","---\n","### Formulazione Matematica 1D e Guadagno di Kalman ($K$)\n","\n","#### 1. Predict Step (Aggiornamento del Moto)\n","$$\\mu_{\\text{pred}} = \\mu + u$$\n","$$\\sigma_{\\text{pred}}^2 = \\sigma^2 + \\sigma_u^2$$\n","\n","#### 2. Update Step (Sensor Fusion & Kalman Gain)\n","Il **Guadagno di Kalman ($K$)** rappresenta il peso (compreso tra $0$ e $1$) dato alla misurazione del sensore rispetto alla stima della predizione:\n","\n","$$K = \\frac{\\sigma_{\\text{pred}}^2}{\\sigma_{\\text{pred}}^2 + \\sigma_m^2}$$\n","\n","* **Aggiornamento dello Stato (Media):**\n","  $$\\mu_{\\text{new}} = \\mu_{\\text{pred}} + K \\cdot (z - \\mu_{\\text{pred}})$$\n","  *(Dove $z - \\mu_{\\text{pred}}$ è l'**Innovazione** o Residuo di Misura)*\n","\n","* **Aggiornamento dell'Incertezza (Varianza):**\n","  $$\\sigma_{\\text{new}}^2 = (1 - K) \\cdot \\sigma_{\\text{pred}}^2$$\n","\n","---\n","### Legenda dei Simboli\n","* $\\mu, \\sigma^2$: Stima corrente della posizione (media) e relativa incertezza (varianza).\n","* $u, \\sigma_u^2$: Spostamento cinematico e varianza del rumore di moto.\n","* $z, \\sigma_m^2$: Misurazione del sensore e varianza del rumore di misura.\n","* $K$: Guadagno di Kalman ($K \\in [0, 1]$)."],"metadata":{"id":"_IwCsCGzX0Lo"}},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Enable inline plotting with clean styling\n","%matplotlib inline\n","plt.style.use('seaborn-v0_8-whitegrid') if 'seaborn-v0_8-whitegrid' in plt.style.available else plt.style.use('ggplot')"],"metadata":{"id":"CoDhNaL8YhIM","executionInfo":{"status":"ok","timestamp":1791187522107,"user_tz":-120,"elapsed":11,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}}},"execution_count":1,"outputs":[]},{"cell_type":"code","metadata":{"id":"OiW7BmsOEmPo","executionInfo":{"status":"ok","timestamp":1791187522117,"user_tz":-120,"elapsed":2,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}}},"source":["def gaussian(x, mean, var):\n","    \"\"\"Calcola la funzione di densità di probabilità di una Gaussiana 1D.\"\"\"\n","    return (1.0 / np.sqrt(2.0 * np.pi * var)) * np.exp(-0.5 * ((x - mean) ** 2) / var)\n","\n","def predict(mean_prior, var_prior, motion, var_motion):\n","    \"\"\"\n","    1. PREDICT STEP: Proietta lo stato nel tempo.\n","    L'incertezza aumenta: var_pred = var_prior + var_motion\n","    \"\"\"\n","    new_mean = mean_prior + motion\n","    new_var = var_prior + var_motion\n","    return new_mean, new_var\n","\n","def update(mean_pred, var_pred, mean_meas, var_meas):\n","    \"\"\"\n","    2. UPDATE STEP: Corregge la stima tramite il Kalman Gain (K).\n","    Returns (new_mean, new_var, K)\n","    \"\"\"\n","    # A. Calcolo del Guadagno di Kalman K (peso tra 0 e 1). Basso=credo la predizione, alto=credo la misura\n","    K = var_pred / (var_pred + var_meas)\n","\n","    # B. Aggiornamento dello stato media usando l'Innovazione (misura - predizione)\n","    innovation = mean_meas - mean_pred\n","    new_mean = mean_pred + K * innovation\n","\n","    # C. Aggiornamento dell'incertezza (varianza ridotta)\n","    new_var = (1.0 - K) * var_pred\n","\n","    return new_mean, new_var, K"],"execution_count":2,"outputs":[]},{"cell_type":"code","metadata":{"id":"Jq2EKGAeEpe9","executionInfo":{"status":"ok","timestamp":1791187522126,"user_tz":-120,"elapsed":2,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}}},"source":["def plot_step(x_axis, mean_prior, var_prior, mean_meas, var_meas, mean_post, var_post, K, step_num):\n","    \"\"\"\n","    Visualizza le Gaussiane di Prior, Misura e Posterior per mostrare la Sensor Fusion.\n","    \"\"\"\n","    plt.figure(figsize=(9, 4.5))\n","\n","    # Calcolo delle PDF\n","    pdf_prior = gaussian(x_axis, mean_prior, var_prior)\n","    pdf_meas = gaussian(x_axis, mean_meas, var_meas)\n","    pdf_post = gaussian(x_axis, mean_post, var_post)\n","\n","    # Plot delle curve\n","    plt.plot(x_axis, pdf_prior, 'r--', label=rf'Prior Estimate ($\\mu$={mean_prior:.2f}, $\\sigma^2$={var_prior:.2f})', linewidth=2)\n","    plt.plot(x_axis, pdf_meas, 'g--', label=rf'Measurement ($z$={mean_meas:.2f}, $\\sigma_m^2$={var_meas:.2f})', linewidth=2)\n","    plt.plot(x_axis, pdf_post, 'b-', label=rf'Posterior Update ($\\mu$={mean_post:.2f}, $\\sigma^2$={var_post:.2f})', linewidth=3)\n","\n","    plt.title(f\"Step {step_num}: Measurement Update (Kalman Gain K = {K:.4f})\", fontsize=13)\n","    plt.xlabel(\"Position ($x$)\", fontsize=11)\n","    plt.ylabel(\"Probability Density\", fontsize=11)\n","    plt.legend(loc='upper right', frameon=True)\n","    plt.xlim(x_axis[0], x_axis[-1])\n","    plt.tight_layout()\n","    plt.show()"],"execution_count":3,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"nBxJy4erEro2","executionInfo":{"status":"ok","timestamp":1791187526231,"user_tz":-120,"elapsed":4099,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}},"outputId":"290aadfc-bdc2-42f1-efa8-e3632fb49c3b"},"source":["# --- Definizione del problema ---\n","measurements = [3.0, 4.0, 6.0, 7.0, 8.0]\n","motion = [1.0, 2.0, 1.0, 1.0, 1.0]\n","\n","# Varianze (sigma^2)\n","var_measurement = 1.0   # Incertezza del sensore\n","var_motion = 4.0        # Incertezza del moto\n","\n","# Stato Iniziale\n","mu = 0.0                # Stima posizione iniziale\n","var_pos = 1.0           # Varianza iniziale\n","\n","x_range = np.arange(-5, 15, 0.05)\n","\n","# Tracciamento storico\n","history_mu = [mu]\n","history_var = [var_pos]\n","\n","print(\"Inizio Loop del Filtro di Kalman...\\n\")\n","\n","for n in range(len(measurements)):\n","    # 1. Update Step (Correzione con Misura e Calcolo di K)\n","    mu_prior, var_prior = mu, var_pos\n","    mu, var_pos, K = update(mu_prior, var_prior, measurements[n], var_measurement)\n","\n","    # Plot del singolo passo (mostrando K)\n","    plot_step(x_range, mu_prior, var_prior, measurements[n], var_measurement, mu, var_pos, K, n + 1)\n","\n","    print(f\"Step {n+1} [Update]  -> K = {K:.4f} | Media Posizione: {mu:.3f}, Varianza: {var_pos:.3f}\")\n","\n","    # 2. Predict Step (Predizione del Moto)\n","    mu, var_pos = predict(mu, var_pos, motion[n], var_motion)\n","    print(f\"Step {n+1} [Predict] -> Media Posizione: {mu:.3f}, Varianza: {var_pos:.3f}\\n\" + \"-\"*50)\n","\n","    history_mu.append(mu)\n","    history_var.append(var_pos)"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Inizio Loop del Filtro di Kalman...\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Step 1 [Update]  -> K = 0.5000 | Media Posizione: 1.500, Varianza: 0.500\n","Step 1 [Predict] -> Media Posizione: 2.500, Varianza: 4.500\n","--------------------------------------------------\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Step 2 [Update]  -> K = 0.8182 | Media Posizione: 3.727, Varianza: 0.818\n","Step 2 [Predict] -> Media Posizione: 5.727, Varianza: 4.818\n","--------------------------------------------------\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Step 3 [Update]  -> K = 0.8281 | Media Posizione: 5.953, Varianza: 0.828\n","Step 3 [Predict] -> Media Posizione: 6.953, Varianza: 4.828\n","--------------------------------------------------\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Step 4 [Update]  -> K = 0.8284 | Media Posizione: 6.992, Varianza: 0.828\n","Step 4 [Predict] -> Media Posizione: 7.992, Varianza: 4.828\n","--------------------------------------------------\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Step 5 [Update]  -> K = 0.8284 | Media Posizione: 7.999, Varianza: 0.828\n","Step 5 [Predict] -> Media Posizione: 8.999, Varianza: 4.828\n","--------------------------------------------------\n"]}]},{"cell_type":"code","source":["#Trajectory & Uncertainty Boundary Summary Plot\n","steps = np.arange(len(history_mu))\n","std_devs = np.sqrt(history_var)\n","\n","plt.figure(figsize=(10, 5))\n","# Use raw strings rf'...' to handle LaTeX \\mu and \\pm correctly\n","plt.plot(steps, history_mu, 'o-', color='blue', label=rf'Estimated Position ($\\mu$)')\n","plt.fill_between(steps,\n","                 np.array(history_mu) - std_devs,\n","                 np.array(history_mu) + std_devs,\n","                 color='blue', alpha=0.2, label=rf'Uncertainty ($\\pm 1\\sigma$)')\n","\n","# Plot measurements\n","plt.scatter(np.arange(1, len(measurements) + 1), measurements, color='green', zorder=5, label=rf'Measurements ($z$)')\n","\n","plt.title(\"Kalman Filter Trajectory & Uncertainty Shrinkage/Growth\", fontsize=13)\n","plt.xlabel(\"Step\", fontsize=11)\n","plt.ylabel(\"Position\", fontsize=11)\n","plt.xticks(steps)\n","plt.legend(loc='upper left', frameon=True)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"8tOkwEYCZE4Z","executionInfo":{"status":"ok","timestamp":1791187526689,"user_tz":-120,"elapsed":448,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}},"outputId":"ac569f7d-0748-48b6-9029-af2f3befa8b9"},"execution_count":5,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["## Esempio 2: Simulazione Interattiva con Ground Truth e Kalman Gain\n","\n","Nella simulazione sottostante:\n","* **Fisica Reale (Ground Truth):** Generata in modo fisso per permettere il confronto tra diversi valori dei parametri.\n","* **Kalman Gain in Tempo Reale ($K$):** Variando gli slider $\\sigma_u^2$ (moto) e $\\sigma_m^2$ (sensore), osserva come varia il valore di $K$ e come la stima di Kalman sceglie se fidarsi del sensore o del modello di moto:\n","  * **$K \\to 1$:** Sensore molto preciso ($\\sigma_m^2 \\ll \\sigma_u^2$) $\\rightarrow$ La stima segue fedelmente i pallini rossi delle misurazioni.\n","  * **$K \\to 0$:** Sensore molto rumoroso ($\\sigma_m^2 \\gg \\sigma_u^2$) $\\rightarrow$ La stima ignora il rumore del sensore e segue il modello di moto."],"metadata":{"id":"mbgE5tjzaJkF"}},{"cell_type":"code","source":["from ipywidgets import interact, FloatSlider, Layout\n","# Generiamo la fisica reale e il rumore fisso esternamente alla funzione\n","np.random.seed(42)\n","num_steps = 30\n","u_nominal = 1.2\n","\n","raw_motion_noise = np.random.normal(0, 1, num_steps)\n","raw_meas_noise = np.random.normal(0, 1, num_steps)\n","\n","def simula_kalman_corretto(var_motion=1.0, var_meas=10.0, initial_var=10.0):\n","    std_motion = np.sqrt(var_motion)\n","    std_meas = np.sqrt(var_meas)\n","\n","    # 1. Ricostruzione della traiettoria reale e delle misurazioni\n","    ground_truth = [0.0]\n","    measurements = [0.0 + raw_meas_noise[0] * std_meas]\n","\n","    for t in range(1, num_steps):\n","        x_true = ground_truth[-1] + u_nominal + raw_motion_noise[t] * std_motion\n","        ground_truth.append(x_true)\n","        measurements.append(x_true + raw_meas_noise[t] * std_meas)\n","\n","    # 2. Esecuzione del Filtro di Kalman\n","    mu = 0.0\n","    var_pos = initial_var\n","\n","    history_mu = [mu]\n","    history_var = [var_pos]\n","    history_K = []\n","\n","    for t in range(1, num_steps):\n","        # Predict\n","        mu_pred, var_pred = predict(mu, var_pos, u_nominal, var_motion)\n","\n","        # Update esplicito con K\n","        mu, var_pos, K = update(mu_pred, var_pred, measurements[t], var_meas)\n","\n","        history_mu.append(mu)\n","        history_var.append(var_pos)\n","        history_K.append(K)\n","\n","    K_steady = history_K[-1] if len(history_K) > 0 else 0.0\n","    errore = np.abs(np.array(ground_truth) - np.array(history_mu))\n","\n","    # 3. Plotting\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 6), sharex=True)\n","    time_steps = np.arange(num_steps)\n","\n","    # Grafico 1: Traiettoria\n","    ax1.plot(time_steps, ground_truth, 'k--', linewidth=2, label='Ground Truth')\n","    ax1.scatter(time_steps, measurements, color='red', alpha=0.6, label='Misurazioni (Noisy)')\n","    ax1.plot(time_steps, history_mu, 'b-', linewidth=2, label='Stima Kalman')\n","\n","    std_bounds = 2 * np.sqrt(history_var)\n","    ax1.fill_between(time_steps,\n","                     np.array(history_mu) - std_bounds,\n","                     np.array(history_mu) + std_bounds,\n","                     color='blue', alpha=0.15, label=r'$\\pm 2\\sigma$ Incertezza')\n","\n","    ax1.set_ylabel(\"Posizione\")\n","    ax1.set_title(rf\"Stima dello Stato (Moto $\\sigma_u^2={var_motion:.1f}$, Sensore $\\sigma_m^2={var_meas:.1f}$, $K \\approx {K_steady:.3f}$)\")\n","    ax1.legend(loc='upper left')\n","    ax1.grid(True, alpha=0.3)\n","\n","    # Grafico 2: Errore Assoluto\n","    ax2.plot(time_steps, errore, color='crimson', linewidth=2, label='Errore |x_true - x_est|')\n","    ax2.axhline(np.mean(errore), color='black', linestyle=':', label=f'Errore Medio: {np.mean(errore):.2f}')\n","    ax2.set_xlabel(\"Passo Temporale (t)\")\n","    ax2.set_ylabel(\"Errore Assoluto\")\n","    ax2.set_title(\"Evoluzione dell'Errore nel Tempo\")\n","    ax2.legend(loc='upper right')\n","    ax2.grid(True, alpha=0.3)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","# Controlli Slider (Limiti calibrati per una resa didattica ottimale)\n","slider_layout = Layout(width='450px')\n","\n","interact(\n","    simula_kalman_corretto,\n","    var_motion=FloatSlider(min=0.1, max=10.0, step=0.1, value=1.0, description=r'$\\sigma_u^2$ (Moto):', layout=slider_layout),\n","    var_meas=FloatSlider(min=0.1, max=50.0, step=1.0, value=5.0, description=r'$\\sigma_m^2$ (Sensore):', layout=slider_layout),\n","    initial_var=FloatSlider(min=0.1, max=20.0, step=1.0, value=10.0, description=r'$\\sigma_0^2$ (Iniziale):', layout=slider_layout)\n",");"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":703,"referenced_widgets":["cf342adb523d4233b7c75e3438551223","339f6ec2f8974707a23118536b55550e","d5332f255d844766a8e610f4df4a0efd","f80aebdb0475461b982179c2fae53c58","503368de8f6644c6b4a82b51fc4bfb8d","c5e6b1f3b54e4e9f8e85ae34e0c7a6f2","3c30c204f692425483af0336b8c7b262","2d565083e88843cf9ef8eb2c226a1389","4749ef1863754f2f8d5c1cabc10aadd1","be6137881e88435d900b42080e3b17a9","26739de6518841cfbfd81c5121529da8"]},"id":"QXnOzYQBaDBB","executionInfo":{"status":"ok","timestamp":1791187754423,"user_tz":-120,"elapsed":1214,"user":{"displayName":"Ignacio Sanudo Olmedo","userId":"04269567670481823204"}},"outputId":"1f5d7c1f-4bb7-4373-c4ae-7cb1772b9fdb"},"execution_count":13,"outputs":[{"output_type":"display_data","data":{"text/plain":["interactive(children=(FloatSlider(value=1.0, description='$\\\\sigma_u^2$ (Moto):', layout=Layout(